rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Explicit user-level isolation: Each user only accesses their own documents
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /memories/{memoryId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /commands/{commandId} {
        // Mobile clients may read their own commands
        allow read: if request.auth != null && request.auth.uid == userId;

        // Mobile clients may CREATE commands with initial status PENDING/QUEUED,
        // and cannot set worker-owned fields (lease_owner, leased_until, result, error, worker_id).
        allow create: if request.auth != null 
          && request.auth.uid == userId
          && request.resource.data.user_id == userId
          && request.resource.data.status in ['PENDING', 'pending', 'QUEUED', 'queued']
          && (!('lease_owner' in request.resource.data) || request.resource.data.lease_owner == null)
          && (!('leased_until' in request.resource.data) || request.resource.data.leased_until == null)
          && (!('lease_expires_at' in request.resource.data) || request.resource.data.lease_expires_at == null)
          && (!('result' in request.resource.data) || request.resource.data.result == null)
          && (!('error' in request.resource.data) || request.resource.data.error == null)
          && (!('worker_id' in request.resource.data) || request.resource.data.worker_id == null);

        // Mobile clients may ONLY update commands to cancel or respond to pending approvals.
        // They CANNOT modify worker-owned execution status (e.g. COMPLETED, RUNNING),
        // lease state, result, error, or bypass approval verification.
        allow update: if request.auth != null
          && request.auth.uid == userId
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'lease_owner', 'leased_until', 'lease_expires_at', 'result', 'error', 'worker_id'
            ])
          // Mobile client can cancel an unleased pending command:
          && (
            (resource.data.status in ['PENDING', 'pending'] && request.resource.data.status in ['CANCELLED', 'cancelled'])
            ||
            // Or if status is WAITING_APPROVAL, client can provide approval response
            (resource.data.status in ['WAITING_APPROVAL', 'waiting_approval'] && request.resource.data.status in ['WAITING_APPROVAL', 'waiting_approval', 'CANCELLED', 'cancelled'])
          );

        // Disallow deletion by mobile client
        allow delete: if false;
      }

      match /devices/{deviceId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /sync_state/{stateId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /feedback/{feedbackId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /task_proposals/{proposalId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        // User can only update proposal status from PROPOSED / WAITING_APPROVAL to APPROVED or DISMISSED
        allow update: if request.auth != null
          && request.auth.uid == userId
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['executed_at', 'readback_verified', 'action_result']);
        allow create, delete: if false;
      }
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
