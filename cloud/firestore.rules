rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Explicit user-level isolation: Each user only accesses their own documents
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /memories/{memoryId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /commands/{commandId} {
        // Mobile clients may read their own commands
        allow read: if request.auth != null && request.auth.uid == userId;

        // Mobile clients may CREATE commands with canonical queued status,
        // and cannot set worker-owned fields (lease_owner, leased_until, result, error, worker_id).
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.user_id == userId
          && request.resource.data.id == commandId
          && request.resource.data.status == 'queued'
          && request.resource.data.type in ['agent_run', 'approval_response', 'tool_execution']
          && request.resource.data.idempotency_key is string
          && request.resource.data.keys().hasOnly([
            'id', 'user_id', 'type', 'name', 'source_device', 'target_device',
            'payload', 'status', 'idempotency_key', 'created_at', 'available_at', 'expires_at'
          ]);

        // Approval responses are separate immutable commands. Only an unleased
        // queued command can be cancelled; its identity and arguments stay fixed.
        allow update: if request.auth != null && request.auth.uid == userId
          && resource.data.status == 'queued'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);

        // Disallow deletion by mobile client
        allow delete: if false;
      }

      match /devices/{deviceId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      match /sync_state/{stateId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /feedback/{feedbackId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /task_proposals/{proposalId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow update: if false;
        allow create, delete: if false;
      }
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
