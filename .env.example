# Application Configuration
APP_NAME="Jarvis Core"
ENVIRONMENT="development"
HOST="127.0.0.1"
PORT=8765

# Model Configuration
MODEL_ID="mlx-community/Qwen3.5-4B-MLX-4bit"
INFERENCE_PROFILE="fast"

# Agent Runtime Limits & Defaults
MAX_AGENT_STEPS=12
MAX_TOOL_CALLS=8
MAX_RETRIES=2
DEFAULT_AGENT_MODE="assist"
DEFAULT_TIMEZONE="Europe/Istanbul"
APPROVAL_TTL_SECONDS=300

# Logging
LOG_LEVEL="INFO"

# Gmail Integration & Local AI Processing (Milestone 4.1.1)
GMAIL_ENABLED=false
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_SYNC_LOOKBACK_DAYS=7
GMAIL_MAX_SYNC_MESSAGES=25
EMAIL_DB_PATH="~/Library/Application Support/Jarvis/email.db"
EMAIL_SYNC_SCHEDULE_ENABLED=false
EMAIL_SYNC_TIMES='["09:00", "20:00"]'
